{
  "name": "holdfast",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "npm run typegen && tsc --noEmit",
    "test": "vitest run",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply holdfast --local",
    "db:migrate:remote": "wrangler d1 migrations apply holdfast --remote",
    "typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts && next typegen"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
